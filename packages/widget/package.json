{
  "name": "@cerid/widget",
  "version": "0.1.0",
  "description": "Embeddable verified-chat web component for Cerid AI Knowledge Companion",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cdn": "./dist/cerid-widget.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode library && vite build --mode cdn",
    "build:cdn": "vite build --mode cdn",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/ --ext .ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/jest-axe": "^3.5.9",
    "axe-core": "^4.10.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "cerid",
    "chat-widget",
    "embeddable",
    "web-component",
    "custom-element",
    "knowledge-base",
    "rag",
    "verified-response"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cerid-AI/cerid-ai.git",
    "directory": "packages/widget"
  },
  "homepage": "https://cerid.ai"
}
