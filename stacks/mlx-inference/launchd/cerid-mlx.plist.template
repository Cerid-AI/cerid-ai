<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by install.py; edit the template, not the installed copy. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{PYTHON}}</string>
    <string>-u</string>
    <string>{{HOME_DIR}}/serve.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{HOME_DIR}}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{ERR_LOG}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CERID_MLX_BIND</key>
    <string>0.0.0.0</string>
    <key>CERID_MLX_ALLOW</key>
    <string>{{ALLOW}}</string>
    <key>CERID_MLX_PORT</key>
    <string>{{PORT}}</string>
  </dict>
</dict>
</plist>
