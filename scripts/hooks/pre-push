#!/usr/bin/env bash
# Pre-push hook: run full local validation before allowing a push, so GitHub
# Action minutes are only spent at merge time (merge queue), not on broken pushes.
#
# Install: git config core.hooksPath scripts/hooks   (or: make install-hooks)
# Escape hatch: git push --no-verify
set -euo pipefail

# Skip when the push only deletes refs (local sha is all-zeros for every ref).
ZERO=0000000000000000000000000000000000000000
deleting_only=true
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" != "$ZERO" ] && deleting_only=false
done
$deleting_only && exit 0

cd "$(git rev-parse --show-toplevel)"

# ci-local + drift-check, NOT the full `make prepush`.
#
# This ran `make ci-local` alone until 2026-08-04, which is a subset — it misses
# drift-check entirely, so a design-drift or manifest violation could only fail
# after a push. drift-check is added here.
#
# It is deliberately NOT the full `make prepush`. A pre-push hook has a hard
# ceiling that has nothing to do with what is worth checking: `git push` opens
# the connection to the remote BEFORE running this hook (it needs the remote
# refs for the hook's stdin), so a long hook leaves that connection idle.
# `make prepush` takes ~25 minutes and GitHub closes the SSH connection while it
# runs — the gate passes, prints "pushing", and the transfer then fails with
# "Connection to github.com closed by remote host". Verified twice on
# 2026-08-04; neither push landed.
#
# Full parity has two homes instead:
#   * `make prepush` — run it manually before a significant push.
#   * the `ci-ok` job — blocking, and on push:main a SKIPPED gate fails too, so
#     nothing can quietly not-run remotely.
echo "── pre-push: running local validation (ci-local + drift-check) ──"
echo "   full parity is `make prepush`; override: git push --no-verify"
if make ci-local && make drift-check; then
  echo "── pre-push: ✓ local validation passed — pushing ──"
  exit 0
fi
echo "── pre-push: ✗ local validation FAILED — push blocked ──"
echo "   Fix the failures above, or override with: git push --no-verify"
exit 1
