#!/usr/bin/env bash
# Pre-push hook: run full local validation before allowing a push, so GitHub
# Action minutes are only spent at merge time (merge queue), not on broken pushes.
#
# Install: git config core.hooksPath scripts/hooks   (or: make install-hooks)
# Escape hatch: git push --no-verify
set -euo pipefail

# Skip when the push only deletes refs (local sha is all-zeros for every ref).
ZERO=0000000000000000000000000000000000000000
deleting_only=true
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" != "$ZERO" ] && deleting_only=false
done
$deleting_only && exit 0

cd "$(git rev-parse --show-toplevel)"

# `make prepush`, not `make ci-local`. ci-local is a SUBSET: it covers the
# lint/typecheck/test jobs and nothing else, so drift-check plus the security,
# sdk-contract, lock-sync and frontend jobs could only fail after a push. On
# 2026-08-04 that is exactly what happened — main was red for eight consecutive
# runs on a cryptography advisory and a ReDoS regex, neither of which any local
# gate was capable of seeing.
echo "── pre-push: running FULL CI parity (make prepush) ──"
echo "   this is the whole workflow (~20-25 min); override: git push --no-verify"
if make prepush; then
  echo "── pre-push: ✓ full validation passed — pushing ──"
  exit 0
fi
echo "── pre-push: ✗ local validation FAILED — push blocked ──"
echo "   Fix the failures above, or override with: git push --no-verify"
exit 1
