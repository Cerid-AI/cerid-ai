# Cerid-web environment variables.
#
# Copy to .env.local (gitignored) and fill in real values. Only
# variables prefixed with VITE_ are exposed to the browser bundle.

# --- Sentry (Phase PT6) ---
# Frontend error reporting via @sentry/react. Leave empty in dev / test
# to disable; only fires in production builds when set. Get the DSN
# from the cerid-ai-mcp Sentry project's web sibling (planned: a
# separate cerid-ai-web project in the same org).
VITE_SENTRY_DSN_WEB=

# Optional: app version stamped into Sentry release tag. Electron
# packaging sets this automatically; the standalone web build can
# leave it unset (defaults to "dev").
VITE_APP_VERSION=
