exports[`VerifiedResponse — streaming state > snapshot matches streaming state 1`] = `
<div>
  <div
    aria-label="Verifying…"
    aria-live="polite"
    class="mt-2 flex flex-wrap items-center gap-2"
    data-verification-state="streaming"
    role="status"
  >
    <svg
      aria-hidden="true"
      class="lucide lucide-loader-circle h-3.5 w-3.5 animate-spin text-muted-foreground"
      fill="none"
      height="24"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M21 12a9 9 0 1 1-6.219-8.56"
      />
    </svg>
    <span
      class="sr-only"
    >
      Verifying…
    </span>
    <div
      class="animate-pulse bg-muted h-6 w-28 rounded-full"
      data-slot="skeleton"
    />
    <div
      class="animate-pulse bg-muted h-6 w-20 rounded-full"
      data-slot="skeleton"
    />
    <div
      class="animate-pulse bg-muted h-6 w-24 rounded-full"
      data-slot="skeleton"
    />
  </div>
</div>
`;
