[importlinter]
root_packages =
    core
    app
    config
include_external_packages = true

[importlinter:contract:1]
name = core must not import app
type = forbidden
source_modules =
    core
forbidden_modules =
    app
    routers
    services
    middleware
    parsers
    sync
    models
    deps
    tools
    main
    scheduler
    db
    eval
    stores
    agents
# No ignore_imports. The last allowlisted core→app violations (inbox_triage's
# DataSourceRegistry import + daily_digest's app.db.neo4j / app.deps imports)
# were removed by the 2026-06-29 Sprint LC DI lift (set_inbox_registry /
# set_digest_graph, mirroring set_data_source_registry). The contract is now
# exceptionless — exactly what CLAUDE.md asserts.

# config contract removed: config.settings legitimately imports utils.model_registry
# The critical boundary (core must not import app) is enforced above
